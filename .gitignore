*.onnx
*.engine
*.pt
*.pth
models/

# Recorded data (keypoints only, but still not source)
data/tracks/
data/tracks_depth/
data/events/
# classify-view frame cache (rendered colour frames -- convenience, not source)
data/classify_cache/
# derived per-frame feature CSVs, regenerable via `ahfd export-features`
data/features/
# error-analysis dumps (wrong-frame CSV + tree rules), regenerable
data/error_analysis/
debug_captures/

